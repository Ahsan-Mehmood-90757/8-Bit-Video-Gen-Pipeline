# ---- Generated by the pipeline (re-created on every render) ----
**/build/
**/qa/
**/output/
channels/*/exports/

# Media files of any kind (renders, narration, intermediates)
*.mp4
*.mkv
*.webm
*.mov
*.wav
*.mp3
*.png
*.jpg

# ---- Large / machine-specific ----
venv/
.venv/
__pycache__/
*.pyc

# Voice models (downloaded by setup_windows.bat, ~340 MB)
models/*
!models/README.txt

# Legacy v1 folder (replaced by channels/examples/)
/episodes/

# ---- OS / editor noise ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.log
